# lab.env.example — les clés que CE dépôt lit, et rien d'autre.
#
# ⚠️ Ce fichier n'a pas à être copié ici dans le cas normal : `lab.env` vit dans le dépôt
#    Vagrant du lab (`../Vagrant-Talos/lab.env` ou `../Vagrant-KubeADM/lab.env`), et les
#    scripts vont le chercher là-bas tout seuls. Cette copie d'exemple sert à deux choses :
#      1. documenter, en un seul endroit, ce que la couche Kubernetes consomme ;
#      2. permettre un test isolé : `cp lab.env.example lab.env` ici prend le pas sur le lab
#         (ou, plus propre : `LAB_ENV=/chemin/vers/lab.env ./install.sh talos platform`).
#
# Priorité de lecture, pour chaque clé : variable d'environnement > `_out/cluster.env`
# (kubeadm : les FAITS détectés sur le cluster) > `lab.env` (l'INTENTION) > défaut du profil.

# --- Distribution cible ------------------------------------------------------
# Évite de la répéter en argument. Ordre de résolution complet : argument positionnel,
# --distro=, $K8S_DISTRO, cette clé, puis détection sur le cluster (osImage du 1er node).
#DISTRO=talos                  # talos | kubeadm

# --- Domaine des UI ----------------------------------------------------------
# Les manifestes versionnés portent le domaine NEUTRE `lab.example.io`, substitué à la volée.
# Défaut si absent : `<distro>.lab.example.io`.
#LAB_DOMAIN=k8s.mon-domaine.tld

# --- Mode TLS du wildcard ----------------------------------------------------
# true  (défaut) : AC locale + openssl (self-signed/) — marche hors-ligne, aucun DNS public
# false          : cert-manager + Let's Encrypt (DNS-01 Cloudflare) — exige un VRAI domaine
#SELF_SIGNED=true
#CLOUDFLARE_API_TOKEN=         # requis seulement si SELF_SIGNED=false (droits Zone:DNS:Edit)
#LAB_DNS_ZONE=mon-domaine.tld  # défaut : les 2 derniers labels de LAB_DOMAIN
#LAB_ACME_EMAIL=moi@mon-domaine.tld
#LAB_ACME_ISSUER=staging       # staging (défaut, cert NON trusté) | prod (quota 5/semaine !)

# --- CNI ---------------------------------------------------------------------
# cilium  (défaut) : CNI + pool d'IP LoadBalancer + annonce L2 => les UI sont joignables
# calico           : CNI seul (pas d'annonce L2 : Gateway en <pending> sans MetalLB)
# flannel          : CNI seul — déjà posé au bootstrap sur Talos, installé ici sur kubeadm
# none             : rien n'est posé, c'est à toi
#CNI=cilium
#CILIUM_VERSION=1.20.0

# ⚠️ kubeadm UNIQUEMENT : remplacement eBPF de kube-proxy par Cilium. DOIT refléter ce qui a
# réellement été fait au bootstrap (`kubeadm init --skip-phases=addon/kube-proxy`), et EXIGE
# CNI=cilium. Sur Talos, kube-proxy est toujours posé : la clé est ignorée.
#KUBE_PROXY_REPLACEMENT=true

# --- Réseau du lab -----------------------------------------------------------
#NETWORK=192.168.56            # préfixe /24 du réseau host-only
#VIP=192.168.56.5              # VIP de l'apiserver (keepalived sur kubeadm, VIP Talos sinon)
#POD_CIDR=10.244.0.0/16        # doit == podSubnet(s) du cluster
#HOSTONLY_IF=eth1              # kubeadm : DÉTECTÉ dans _out/cluster.env — Talos : enp0s8
#LB_POOL_START=192.168.56.200  # la 1re IP est celle que prend le Gateway (cible du DNS wildcard)
#LB_POOL_END=192.168.56.230

# --- Topologie (lue par longhorn/ sur Talos, pour adresser les workers) ------
#WORKERS=3
#WK_IP_START=101
#WK_IP_STEP=1
